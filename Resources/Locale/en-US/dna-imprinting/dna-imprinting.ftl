reagent-name-miniozine = miniozine
reagent-name-ragorium = ragorium

reagent-desc-miniozine = An experimental modification to cognizine that sacrifices many of the higher faculties in exchange for undying loyalty.
reagent-desc-ragorium = An experimental chemical which drives nonsentient life into a killing frenzy.

entity-effect-guidebook-dna-imprint = { $chance ->
    [1] Imprints
    *[other] imprint
    } the associated DNA, binding weak minded metabolizers as minions.

entity-effect-guidebook-dna-hunt = { $chance ->
    [1] Induces
    *[other] induce
    } rage within weak minded metabolizers to hunt down the associated DNA.
