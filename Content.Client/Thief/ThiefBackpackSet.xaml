<Control xmlns="https://spacestation14.io"
		xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
		xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
	<!-- Name and button -->
	<PanelContainer Margin="5" StyleClasses="PanelInsetDeep">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <BoxContainer HorizontalExpand="True">
                <Label Name="SetName" Text="Set" StyleClasses="highlight"></Label>
                <Control HorizontalExpand="True" />
                <Button Margin="10" Name="SetButton" Text="{Loc 'thief-backpack-button-select'}" Access="Public" HorizontalAlignment="Right"/>
            </BoxContainer>
            <controls:Separator ColorOverride="#404040" Thickness="1" Margin="0 5"/>
            <!-- Icon and Description -->
            <BoxContainer Margin="0 5">
                <TextureRect Name="Icon" Margin="10" Stretch="KeepAspectCentered"
                            VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="64 64"/>
                <RichTextLabel Margin="0 0 10 0" Name="SetDescription" Text="Description" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
