<ContainerButton xmlns="https://spacestation14.io"
		xmlns:thief="clr-namespace:Content.Client.Thief"
		xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        Margin="5">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <BoxContainer HorizontalExpand="True">
            <Label Name="SetName" Margin="5" StyleClasses="highlight" />
            <Control HorizontalExpand="True" />
            <TextureRect StyleIdentifier="SelectedIndicator" Margin="0 0 5 0"
                MouseFilter="Pass" ToolTip="{Loc 'thief-backpack-selected-tooltip'}" />
        </BoxContainer>
        <controls:Separator Thickness="2" Margin="0 5"/>
        <BoxContainer Margin="0 5">
            <TextureRect Name="Icon" Margin="10" Stretch="KeepAspectCentered"
                VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="64 64" />
            <RichTextLabel Name="SetDescription" Margin="0 0 10 0" />
        </BoxContainer>
    </BoxContainer>
</ContainerButton>
