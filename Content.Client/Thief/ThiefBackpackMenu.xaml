<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="500 400" SetSize="700 700">
	<BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
		<!-- First Informational panel -->
		<RichTextLabel Name="Description" Margin="5 5"/>
		<controls:Separator ColorOverride="#404040" Margin="0 5"/>
		<RichTextLabel Name="SelectedSets" Text="{Loc 'thief-backpack-window-selected'}" Margin="5 5"/>

		<!-- Second sets panel -->
		<PanelContainer Margin="5 5" VerticalExpand="True" StyleClasses="PanelDark">
			<ScrollContainer
					HScrollEnabled="False"
					SizeFlagsStretchRatio="2"
					VerticalExpand="True">
				<BoxContainer Name="SetsGrid" Orientation="Vertical" MinSize="460 200">
					<!-- Sets is filled by code -->
				</BoxContainer>
			</ScrollContainer>
		</PanelContainer>
		<!-- Third approve button panel -->
        <Button Name="ApproveButton"
                Text="{Loc 'thief-backpack-window-approve-button'}"
                Margin="10 5 10 10"
                Access="Public"
                HorizontalAlignment ="Right"/>
	</BoxContainer>
</controls:FancyWindow>
