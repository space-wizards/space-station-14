<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'genetics-console-window-title'}"
               SetSize="960 640"
               MinSize="850 580">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <PanelContainer StyleClasses="PanelInsetDark">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Name="ScannerStatus" HorizontalExpand="True" />
                    <Button Name="ScrambleButton" Text="{Loc 'genetics-console-scramble-dna'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Name="SubjectLabel" StyleClasses="LabelKeyText" HorizontalExpand="True" />
                    <Label Name="InstabilityLabel" MinSize="220 0" />
                    <Button Name="HumanizeButton" Text="{Loc 'genetics-console-humanize-monkey'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                    <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="6">
                            <Label Text="{Loc 'genetics-console-health-label'}" MinSize="70 0" />
                            <ProgressBar Name="HealthBar" MinValue="0" MaxValue="1" MinSize="120 14" HorizontalExpand="True" />
                            <Label Name="HealthValueLabel" MinSize="72 0" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="6">
                            <Label Text="{Loc 'genetics-console-genetic-damage-label'}" MinSize="120 0" />
                            <ProgressBar Name="GeneticDamageBar" MinValue="0" MaxValue="1" MinSize="120 14" HorizontalExpand="True" />
                            <Label Name="GeneticDamageValueLabel" MinSize="72 0" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
                <Label Name="FeedbackLabel" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="ModeTabs" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" Margin="8" VerticalExpand="True" HorizontalExpand="True" SeparationOverride="8">
                <PanelContainer StyleClasses="PanelInsetDark" MinSize="300 0" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="5">
                        <Label Name="MemoryCapacityLabel" StyleClasses="LabelKeyText" />
                        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Name="MemoryList" Orientation="Vertical" HorizontalExpand="True" />
                        </ScrollContainer>
                        <Label Text="{Loc 'genetics-console-save-title'}" StyleClasses="LabelKeyText" />
                        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Name="StorageMutationList" Orientation="Vertical" HorizontalExpand="True" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="PanelInsetDark" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                        <Label Name="StorageSelectedName" StyleClasses="LabelKeyText" />
                        <Label Name="StorageSelectedDescription" VerticalExpand="True" />
                        <Label Name="StorageSelectedInstability" StyleClasses="LabelKeyText" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                            <Button Name="PrintActivatorButton" Text="{Loc 'genetics-console-print-activator'}" HorizontalExpand="True" />
                            <Button Name="PrintMutatorButton" Text="{Loc 'genetics-console-print-mutator'}" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" Margin="8" VerticalExpand="True" HorizontalExpand="True" SeparationOverride="8">
                <PanelContainer StyleClasses="PanelInsetDark" MinSize="175 0" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                        <Label Text="{Loc 'genetics-console-gene-bank'}" StyleClasses="LabelKeyText" />
                        <ScrollContainer VerticalExpand="True">
                            <BoxContainer Name="MutationList" Orientation="Vertical" HorizontalExpand="True" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="PanelInsetDark" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                        <Label Name="SelectedMutationName" StyleClasses="LabelKeyText" />
                        <Label Name="SelectedMutationDescription" />
                        <Label Name="SequenceProgressLabel" StyleClasses="LabelKeyText" />
                        <Label Text="{Loc 'genetics-console-sequencer-instructions'}" />
                        <BoxContainer Orientation="Vertical" SeparationOverride="3">
                            <GridContainer Name="SequenceTopStrand" Columns="16" MinSize="0 34" HorizontalExpand="True" />
                            <GridContainer Name="SequenceBottomStrand" Columns="16" MinSize="0 34" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                            <Button Name="AnalyzeButton" Text="{Loc 'genetics-console-joker'}" HorizontalExpand="True" />
                            <Button Name="GuessButton" Text="{Loc 'genetics-console-guess'}" HorizontalExpand="True" />
                            <Button Name="ApplySelectedButton" Text="{Loc 'genetics-console-apply'}" HorizontalExpand="True" />
                        </BoxContainer>
                        <Label Text="{Loc 'genetics-console-pair-legend'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
                <Label Text="{Loc 'genetics-console-enzymes-title'}" StyleClasses="LabelKeyText" />
                <Label Text="{Loc 'genetics-console-enzymes-empty'}" />
            </BoxContainer>

            <ScrollContainer HScrollEnabled="False" Margin="8" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="FeaturesList" Orientation="Vertical" HorizontalExpand="True" />
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</DefaultWindow>
