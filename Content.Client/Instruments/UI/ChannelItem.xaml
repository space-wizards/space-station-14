<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls" HorizontalExpand="True">
    <PanelContainer Name="ItemPanel">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#00000044" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" SeparationOverride="10">
            <Label Name="ChannelNumberLabel" Align="Right" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="30" />
            <BoxContainer Orientation="Vertical" MinHeight="0">
                <Label Name="ChannelNameLabel" />
                <RichTextLabel Name="ChannelInfoLabel" />
            </BoxContainer>
            <controls:SwitchButton Name="ChannelEnableSwitchButton"
                                   VerticalAlignment="Top"
                                   HorizontalExpand="True"
                                   HorizontalAlignment="Right"
                                   OnStateText=""
                                   OffStateText="" />
        </BoxContainer>
    </PanelContainer>
</Control>
