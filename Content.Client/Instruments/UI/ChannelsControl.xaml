<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer MinHeight="90">
            <BoxContainer Orientation="Vertical" Name="ChannelsContainer" />
        </ScrollContainer>
        <controls:HSpacer Spacing="10"></controls:HSpacer>
        <GridContainer Columns="5" HSeparationOverride="1" VSeparationOverride="1">
            <!-- All channels switcher -->
            <Label Text="{Loc 'instruments-component-channels-all-channels-label'}" />
            <controls:VSpacer />
            <controls:VSpacer />
            <Button Name="AllButton" Text="{Loc 'instruments-component-channels-all-button'}" HorizontalExpand="true"
                    VerticalExpand="true" StyleClasses="OpenBoth" />
            <Button Name="ClearButton" Text="{Loc 'instruments-component-channels-clear-button'}"
                    HorizontalExpand="true" VerticalExpand="true" StyleClasses="OpenBoth" />

            <!-- Name display selector -->
            <Label Text="{Loc 'instruments-component-channels-name-display-selector-label'}" />
            <controls:VSpacer Spacing="10" />
            <Button Name="TrackSelectorButton"
                    Text="{Loc 'instruments-component-channels-name-display-selector-track-button'}"
                    Pressed="True"
                    HorizontalExpand="true"
                    StyleClasses="OpenBoth" />
            <Button Name="ProgramSelectorButton"
                    Text="{Loc 'instruments-component-channels-name-display-selector-program-button'}"
                    HorizontalExpand="true"
                    StyleClasses="OpenBoth" />
            <Button Name="InstrumentSelectorButton"
                    Text="{Loc 'instruments-component-channels-name-display-selector-instrument-button'}"
                    HorizontalExpand="true"
                    StyleClasses="OpenBoth" />
        </GridContainer>
    </BoxContainer>
</Control>
