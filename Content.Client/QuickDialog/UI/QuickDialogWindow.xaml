<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinWidth="350"
    Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="10">
        <!-- Populated in constructor -->
        <BoxContainer Name="Entries" Margin="0 0 0 10" HorizontalAlignment="Left" Orientation="Vertical" />

        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Margin="10 2 5 0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <Button Name="OkButton" MinWidth="150" Margin="0 0 10 0" Text="{Loc 'quick-dialog-ui-ok'}"/>
                <Button Name="CancelButton" MinWidth="150" Text="{Loc 'quick-dialog-ui-cancel'}"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
