<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <PanelContainer Name="BackgroundColorPlaytimePanel" Access="Public"/>
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="4">
            <Label Name="RoleLabel"
                   SizeFlagsStretchRatio="3"
                   HorizontalExpand="True"
                   ClipText="True"
                   Text="{Loc ui-playtime-header-role-type}"
                   MouseFilter="Pass"
                   Margin="5,5,5,5"/>
            <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" MinHeight="5"/>
            <Label Name="PlaytimeLabel"
                   SizeFlagsStretchRatio="3"
                   HorizontalExpand="True"
                   ClipText="True"
                   Text="{Loc ui-playtime-header-role-time}"
                   MouseFilter="Pass"
                   Margin="5,5,5,5"/>
        </BoxContainer>
        <!-- Horizontal Separator -->
        <controls:Separator StyleClasses="LowDivider"/>
    </BoxContainer>
</Control>
