<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.CF.Lobby.UI.CharacterBuilder.SpellSelectionPopup"
               MinSize="880 560"
               SetSize="960 640">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6" Margin="4">
        <BoxContainer Name="TraditionBar" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
            <Button Name="TabArcane" Text="{Loc 'cf-spell-tradition-arcane'}" ToggleMode="True" HorizontalExpand="True" />
            <Button Name="TabDivine" Text="{Loc 'cf-spell-tradition-divine'}" ToggleMode="True" HorizontalExpand="True" />
            <Button Name="TabOccult" Text="{Loc 'cf-spell-tradition-occult'}" ToggleMode="True" HorizontalExpand="True" />
            <Button Name="TabPrimal" Text="{Loc 'cf-spell-tradition-primal'}" ToggleMode="True" HorizontalExpand="True" />
        </BoxContainer>
        <BoxContainer Name="SpellPickerBody" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
            <PanelContainer StyleClasses="PanelDark" MinWidth="300" VerticalExpand="True">
                <ScrollContainer Name="SpellScroll" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="SpellList" Orientation="Vertical" HorizontalExpand="True" Margin="4" SeparationOverride="2" />
                </ScrollContainer>
            </PanelContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="SpellDetails" Orientation="Vertical" Margin="8 4" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="DetailName" StyleClasses="LabelHeading" HorizontalExpand="True" />
                        <Label Name="DetailRank" />
                    </BoxContainer>
                    <BoxContainer Name="TraitRow" Orientation="Horizontal" Margin="0 6 0 0" SeparationOverride="4" />
                    <RichTextLabel Name="DetailBody" Margin="0 8 0 0" />
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer Name="SpellPickerFooter" Orientation="Horizontal" SeparationOverride="6">
            <Button Name="AcceptButton" Text="{Loc 'cf-character-builder-accept'}" />
            <Button Name="CancelButton" Text="{Loc 'cf-character-builder-cancel'}" />
            <Button Name="PrdButton" Text="{Loc 'cf-character-builder-prd'}" />
            <Button Name="ClearButton" Text="{Loc 'cf-character-builder-clear'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
