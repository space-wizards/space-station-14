<BoxContainer xmlns="https://spacestation14.io"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="Content.Client.CF.Lobby.UI.CharacterBuilder.SkillAssignmentView"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True"
              SeparationOverride="8">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
        <Label Name="TitleLabel" HorizontalExpand="True" />
        <Button Name="CloseButton" Text="{Loc 'cf-character-builder-close'}" MinWidth="36" />
    </BoxContainer>
    <Label Name="HelpLabel" HorizontalExpand="True" />
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
        <BoxContainer Name="SlotsList" Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True" />
    </ScrollContainer>
    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="6">
        <Button Name="CancelButton" Text="{Loc 'cf-character-builder-cancel'}" />
        <Button Name="AcceptButton" Text="{Loc 'cf-character-builder-accept'}" />
    </BoxContainer>
</BoxContainer>
