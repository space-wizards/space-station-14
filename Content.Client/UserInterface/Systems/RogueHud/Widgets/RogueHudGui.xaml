<widgets:RogueHudGui
    xmlns="https://spacestation14.io"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.RogueHud.Widgets"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:inventory="clr-namespace:Content.Client.UserInterface.Systems.Inventory.Controls"
    xmlns:hands="clr-namespace:Content.Client.UserInterface.Systems.Hands.Controls"
    Name="RogueHud"
    HorizontalExpand="True"
    VerticalExpand="True">
    
    <LayoutContainer Name="HudContainer" HorizontalExpand="True" VerticalExpand="True">
        <!-- Fullscreen Background Mask Texture (640x480 Stone Frame) -->
        <TextureRect Name="BackgroundTexture"
                     HorizontalExpand="True"
                     VerticalExpand="True" />

        <!-- 1. Gargoyle Targeting Doll (Positioned inside the Top Stone Arch) -->
        <Control Name="DollContainer" MinWidth="120" MinHeight="120" Margin="30 15 0 0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextureRect Name="DollBaseTexture" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneHead" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneChest" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneRArm" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneLArm" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneRLeg" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextureRect Name="DollZoneLLeg" Visible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Transparent Click Targets for Body Zones -->
            <Button Name="BtnTargetHead" ToolTip="Head" Margin="30 5 30 75" />
            <Button Name="BtnTargetChest" ToolTip="Chest" Margin="25 30 25 40" />
            <Button Name="BtnTargetRArm" ToolTip="Right Arm" Margin="5 30 55 40" />
            <Button Name="BtnTargetLArm" ToolTip="Left Arm" Margin="55 30 5 40" />
            <Button Name="BtnTargetRLeg" ToolTip="Right Leg" Margin="20 60 40 5" />
            <Button Name="BtnTargetLLeg" ToolTip="Left Leg" Margin="40 60 20 5" />
        </Control>

        <!-- 2. Controls & Actions Panel (Positioned on the Shelf below the Arch) -->
        <BoxContainer Orientation="Vertical" Margin="10 145 0 0" HorizontalAlignment="Left" VerticalAlignment="Top">
            
            <!-- Row A: Craft, Skills, Eye -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <TextureButton Name="BtnCraft" ToolTip="Craft" MinWidth="42" MinHeight="22" Margin="1" />
                <TextureButton Name="BtnSkills" ToolTip="Skills" MinWidth="42" MinHeight="22" Margin="1" />
                <TextureRect Name="EyeTexture" Margin="3 0 0 0" VerticalAlignment="Center" />
            </BoxContainer>

            <!-- Row B: Stances & Move -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 2 0 0">
                <TextureButton Name="BtnRun" ToolTip="Run" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnSneak" ToolTip="Sneak" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnParry" ToolTip="Parry" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnDodge" ToolTip="Dodge" MinWidth="34" MinHeight="18" Margin="1" />
            </BoxContainer>

            <!-- Row C: Main Combat Commands & Toggle -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 2 0 0">
                <TextureButton Name="BtnFeint" ToolTip="Feint" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnTouch" ToolTip="Touch" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnShove" ToolTip="Shove" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnCombatToggle" ToolTip="Combat Mode" MinWidth="34" MinHeight="18" Margin="1" />
            </BoxContainer>

            <!-- Row D: Attacks -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 2 0 0">
                <TextureButton Name="BtnGrab" ToolTip="Grab" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnPunch" ToolTip="Punch" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnBite" ToolTip="Bite" MinWidth="34" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnKick" ToolTip="Kick" MinWidth="34" MinHeight="18" Margin="1" />
            </BoxContainer>
        </BoxContainer>

        <!-- 3. Active Hands & Drop/Catch (Positioned on the Lower Platform Shelf) -->
        <BoxContainer Orientation="Horizontal" Margin="10 245 0 0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <hands:HandsContainer Name="HandContainer" Access="Public" ColumnLimit="2" HorizontalAlignment="Center" />
            <BoxContainer Orientation="Vertical" Margin="5 0 0 0" VerticalAlignment="Center">
                <TextureButton Name="BtnDrop" ToolTip="Drop" MinWidth="40" MinHeight="18" Margin="1" />
                <TextureButton Name="BtnCatch" ToolTip="Catch" MinWidth="40" MinHeight="18" Margin="1" />
            </BoxContainer>
        </BoxContainer>

        <!-- 4. Inventory Equipment Slot Grid (Positioned inside the Middle Dark Stone Box) -->
        <BoxContainer Orientation="Vertical" Margin="10 310 0 0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <inventory:ItemSlotButtonContainer Name="InventoryHotbar" Access="Public" Visible="True" Columns="3" HorizontalAlignment="Center" />
            <inventory:ItemSlotButtonContainer Name="MainHotbar" Access="Public" Visible="True" SlotGroup="MainHotbar" Columns="3" HorizontalAlignment="Center" Margin="0 2 0 0" />
            <inventory:ItemSlotButtonContainer Name="SecondHotbar" Access="Public" Visible="True" SlotGroup="SecondHotbar" Columns="3" HorizontalAlignment="Center" Margin="0 2 0 0" />
        </BoxContainer>

    </LayoutContainer>
</widgets:RogueHudGui>
