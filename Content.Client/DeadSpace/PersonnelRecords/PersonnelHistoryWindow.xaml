<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'personnel-records-history-window-title'}"
               MinSize="520 360">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5">
        <Label Name="NoHistory" Text="{Loc 'personnel-records-no-history'}" HorizontalExpand="True" HorizontalAlignment="Center"/>
        <ScrollContainer VerticalExpand="True">
            <ItemList Name="History"/> <!-- Populated when window opened -->
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
