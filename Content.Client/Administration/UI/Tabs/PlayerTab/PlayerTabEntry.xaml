<PanelContainer xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                Name="BackgroundColorPanel">
    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  SeparationOverride="4">
        <Label Name="UsernameLabel"
               SizeFlagsStretchRatio="3"
               HorizontalExpand="True"
               ClipText="True"/>
        <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" MinHeight="5"/>
        <Label Name="CharacterLabel"
               SizeFlagsStretchRatio="3"
               HorizontalExpand="True"
               ClipText="True"/>
        <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" MinHeight="5"/>
        <Label Name="JobLabel"
               SizeFlagsStretchRatio="2"
               HorizontalExpand="True"
               ClipText="True"/>
        <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" MinHeight="5"/>
        <Label Name="RoleTypeLabel"
               SizeFlagsStretchRatio="2"
               HorizontalExpand="True"
               ClipText="True"/>
        <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" MinHeight="5"/>
        <Label Name="OverallPlaytimeLabel"
               SizeFlagsStretchRatio="1"
               HorizontalExpand="True"
               ClipText="True"/>
    </BoxContainer>
</PanelContainer>
