<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Orientation="Vertical"
    HorizontalExpand="True">
    <OutputPanel Name="TextOutput" VerticalExpand="true" />
    <RichTextLabel Name="TypingIndicator" Access="Public" />
    <Button Visible="False" Name="PlayerLogs" StyleClasses="OpenRight" />
    <BoxContainer Align="End" Orientation="Horizontal" SetHeight="30" >
        <TextureButton Name="CopyLog"
                       TexturePath="/Textures/Interface/Bwoink/clipboard.png"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="2"
                       Scale="0.75 0.75" />
        <CheckBox Name="Anonymize"
                  Access="Public"
                  Text="Anonymize"
                  ToolTip="Replace usernames with placeholders."
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
    </BoxContainer>
    <HistoryLineEdit Name="SenderLineEdit" />
    <RichTextLabel Name="RelayedToDiscordLabel" Access="Public" Visible="False" />
</BoxContainer>
