<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc admin-announce-title}"
    MinWidth="650"
    MinHeight="350">
    <BoxContainer Orientation="Vertical" Margin="4">
        <GridContainer Columns="2" HorizontalExpand="True" Margin="0,0,0,4">
            <LineEdit Name="Announcer"
                      PlaceHolder="{Loc admin-announce-announcer-placeholder}"
                      HorizontalExpand="True"
                      Margin="2" />
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="2">
                <LineEdit Name="Signature"
                          PlaceHolder="{Loc admin-announce-signature-placeholder}"
                          HorizontalExpand="True" />
                <CheckBox Name="EnableSignature"
                          ToolTip="{Loc admin-announce-enable-signature-tooltip}"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center" />
            </BoxContainer>
        </GridContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0,0,0,4">
            <BoxContainer Orientation="Horizontal" Margin="2">
                <Button Name="ColorPreview" MinSize="30,30" />
                <Button Name="OpenPresetsButton" Text="{Loc admin-announce-presets}" Margin="4,0,0,0" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="2">
                <LineEdit Name="SoundPath" PlaceHolder="{Loc admin-announce-sound-placeholder}" HorizontalExpand="True" />
                <Button Name="PlayAudio" Text="▶" Margin="4,0,0,0" MinWidth="35" />
                <Button Name="StopAudio" Text="■" Margin="2,0,0,0" MinWidth="35" />
            </BoxContainer>
        </BoxContainer>
        <TextEdit Name="Announcement" VerticalExpand="True" MinHeight="150" Margin="0,4,0,0" />
        <Label Name="AnnounceCharLimitLabel"
               StyleClasses="CommsConsoleCharLimit"
               HorizontalAlignment="Right"
               Margin="0,2,8,0" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0,4,0,0">
            <CheckBox Name="KeepWindowOpen" Text="{Loc admin-announce-keep-open}" VerticalAlignment="Center" />
            <Control HorizontalExpand="True" />
            <Button Name="AnnounceButton" Disabled="True" Text="{Loc admin-announce-button}" MinWidth="150" />
            <OptionButton Name="ScopeOption" MinWidth="150" Margin="4,0,0,0" />
            <OptionButton Name="AnnounceMethod" MinWidth="150" Margin="4,0,0,0" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
