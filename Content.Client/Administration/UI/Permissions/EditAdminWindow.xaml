<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'permissions-eui-menu-add-admin-button'}"
    MinSize="600 400">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  Margin="8">
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="2"
                      VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True">
                <LineEdit Name="NameEdit"
                          PlaceHolder="{Loc 'permissions-eui-edit-admin-window-name-edit-placeholder'}" />
                <LineEdit Name="TitleEdit"
                          PlaceHolder="{Loc 'permissions-eui-edit-admin-window-title-edit-placeholder'}" />
                <OptionButton Name="RankOption" />
                <CheckBox Name="SuspendedCheckbox"
                          Text="{Loc 'permissions-eui-edit-admin-window-suspended'} " />
                <Control VerticalExpand="True" />
                <BoxContainer>
                    <Button Name="SaveButton"
                            HorizontalAlignment="Right"
                            Text="{Loc 'permissions-eui-edit-admin-window-save-button'}"
                            StyleClasses="OpenRight" />
                    <controls:ConfirmButton Name="RemoveButton"
                                            Text="{Loc 'permissions-eui-edit-admin-window-remove-flag-button'}"
                                            Disabled="True"
                                            StyleClasses="OpenLeft"/>
                </BoxContainer>
            </BoxContainer>
            <GridContainer Name="FlagGrid"
                           Columns="4"
                           HSeparationOverride="0"
                           VSeparationOverride="0"
                           Margin="8 0 0 0">
                <!-- Populated by EditAdminWindow.xaml.cs -->
            </GridContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
